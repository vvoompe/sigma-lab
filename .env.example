# Шаблон змінних середовища. Скопіювати як .env і підставити свої значення.
# Сам файл .env у репозиторій не комітиться.

# --- Локальна PostgreSQL (docker/dev-postgres.yml) ---
LAB_PG_DATABASE=lab
LAB_PG_USER=lab
LAB_PG_PASSWORD=змініть_на_свій_локальний_пароль
# Порт, якщо 55432 зайнятий іншим проєктом (тоді ж поправте ConnectionStrings__Postgres)
LAB_PG_PORT=55432

# --- Провайдер для API і тестів: Sqlite або Postgres ---
LAB_DB_PROVIDER=Sqlite

# --- Рядки підключення ---
ConnectionStrings__Sqlite=Data Source=lab.db
ConnectionStrings__Postgres=Host=localhost;Port=55432;Database=lab;Username=lab;Password=змініть_на_свій_локальний_пароль

# --- Тести, які працюють проти реальної PostgreSQL ---
LAB_TEST_POSTGRES=

# --- Запуск міграцій під час старту API (true/false) ---
Database__MigrateOnStartup=true

# --- Інтервал фонового обробника, секунд ---
Worker__IntervalSeconds=300

# --- Секрет підпису JWT (зона Z3 додає автентифікацію) ---
Jwt__Key=
